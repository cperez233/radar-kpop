{
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ':(exclude)state' ':(exclude)CHANGELOG.md' ':(exclude)*.md' ':(exclude).github' ':(exclude)alerts' ':(exclude)backend' ':(exclude)sightings' ':(exclude)src' ':(exclude)tools' ':(exclude)updater' ':(exclude)build.py' ':(exclude).vercelignore'",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(self), camera=(), microphone=(), payment=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
